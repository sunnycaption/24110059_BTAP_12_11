<?xml version="1.0" encoding="UTF-8"?>
<sitemesh>
    <!-- Layout decorator chính cho toàn bộ trang (Bootstrap 5) -->
    <mapping path="/*" decorator="/WEB-INF/decorators/main.jsp" />

    <!-- Loại trừ các trang xác thực (auth) khỏi decorator chính,
         sử dụng layout riêng đơn giản cho login/register/forgot/verify/reset -->
    <mapping path="/login" decorator="/WEB-INF/decorators/auth.jsp" />
    <mapping path="/register" decorator="/WEB-INF/decorators/auth.jsp" />
    <mapping path="/forgot-password" decorator="/WEB-INF/decorators/auth.jsp" />
    <mapping path="/verify-otp" decorator="/WEB-INF/decorators/auth.jsp" />
    <mapping path="/reset-password" decorator="/WEB-INF/decorators/auth.jsp" />
    <mapping path="/verify-email-otp" decorator="/WEB-INF/decorators/auth.jsp" />

    <!-- Loại trừ file tĩnh, API, streaming media và uploads để không bị can thiệp -->
    <mapping path="/uploads/*" exclude="true" />
    <mapping path="/assets/*" exclude="true" />
    <mapping path="/css/*" exclude="true" />
    <mapping path="/js/*" exclude="true" />
    <mapping path="/images/*" exclude="true" />
    <mapping path="/static/*" exclude="true" />
    <mapping path="*.css" exclude="true" />
    <mapping path="*.js" exclude="true" />
    <mapping path="*.mp4" exclude="true" />
    <mapping path="*.webm" exclude="true" />
    <mapping path="*.ico" exclude="true" />
</sitemesh>
