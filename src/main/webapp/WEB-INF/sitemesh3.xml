<?xml version="1.0" encoding="UTF-8"?>
<sitemesh>
    <!-- Mappings to Layout Decorators -->
    <mapping path="/*" name="web" decorator="/WEB-INF/decorators/web.jsp" />
    <mapping path="/admin/*" name="admin" decorator="/WEB-INF/decorators/admin.jsp" />
    <mapping path="/login" name="login" decorator="/WEB-INF/decorators/login.jsp" />
    <mapping path="/register" name="login" decorator="/WEB-INF/decorators/login.jsp" />
    <mapping path="/forgot-password" name="login" decorator="/WEB-INF/decorators/login.jsp" />
    <mapping path="/verify-otp" name="login" decorator="/WEB-INF/decorators/login.jsp" />
    <mapping path="/reset-password" name="login" decorator="/WEB-INF/decorators/login.jsp" />
    <mapping path="/verify-email-otp" name="login" decorator="/WEB-INF/decorators/login.jsp" />

    <!-- Exclude static resources and media streams from decoration -->
    <mapping path="/api*" exclude="true" />
    <mapping path="/uploads/*" exclude="true" />
    <mapping path="/assets/*" exclude="true" />
    <mapping path="/css/*" exclude="true" />
    <mapping path="/js/*" exclude="true" />
    <mapping path="/images/*" exclude="true" />
    <mapping path="/static/*" exclude="true" />
    <mapping path="*.css" exclude="true" />
    <mapping path="*.js" exclude="true" />
    <mapping path="*.mp4" exclude="true" />
    <mapping path="*.webm" exclude="true" />
    <mapping path="*.ico" exclude="true" />
</sitemesh>
